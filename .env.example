# Required for Gemini-backed A1/A3 runs. Never commit a real value.
GEMINI_API_KEY=

# Optional model override. The audited benchmark used this exact model.
MODEL_NAME=gemini-3.1-flash-lite

# Optional live-Gemini resilience. The fallback is used only after retryable
# primary-model failures and its exact model name is recorded in run evidence.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
MODEL_MAX_ATTEMPTS=2
MODEL_FALLBACK_ATTEMPTS=1
MODEL_RETRY_BACKOFF_SECONDS=1

# Optional local sandbox overrides. Defaults match docker-compose.yml.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cutover
POSTGRES_PASSWORD=proof_sandbox_password
POSTGRES_DB=cutoverproof_sandbox

# Demo portal access. Set both values in Cloud Run; never commit the real password.
CUTOVERPROOF_DEMO_EMAIL=judge@cutoverproof.dev
CUTOVERPROOF_DEMO_PASSWORD=
CUTOVERPROOF_COOKIE_SECURE=false

# Optional comma-separated exact hosts judges may use for disposable sandboxes.
# External connections remain disabled when empty.
CUTOVERPROOF_EXTERNAL_SANDBOX_HOSTS=
